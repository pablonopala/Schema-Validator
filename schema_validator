import tkinter as tk
from tkinter import filedialog, messagebox
import polars as pl
import os
import re
import hashlib
from sentence_transformers import SentenceTransformer, util

# =========================
# CONFIG
# =========================
CACHE_DIR = "cache"
os.makedirs(CACHE_DIR, exist_ok=True)

MODEL_NAME = "all-MiniLM-L6-v2"
SIM_THRESHOLD_HIGH = 0.85
SIM_THRESHOLD_LOW = 0.65

# Load model once
model = SentenceTransformer(MODEL_NAME)

# =========================
# FILE HANDLING
# =========================
def get_cache_path(file_path):
    hash_name = hashlib.md5(file_path.encode()).hexdigest()
    return os.path.join(CACHE_DIR, f"{hash_name}.csv")

def convert_to_csv(file_path):
    cached_path = get_cache_path(file_path)

    if os.path.exists(cached_path):
        return cached_path

    if file_path.lower().endswith(".csv"):
        return file_path

    elif file_path.lower().endswith(".xlsx"):
        df = pl.read_excel(file_path, engine="openpyxl")
        df.write_csv(cached_path)
        return cached_path

    else:
        raise ValueError("Unsupported file format")

def get_columns(file_path):
    csv_path = convert_to_csv(file_path)
    return pl.scan_csv(csv_path).collect_schema().names()

# Text normalization
def normalize(text):
    text = text.lower().strip()
    text = re.sub(r'[\s_\-]+', ' ', text)
    text = re.sub(r'[^\w\s]', '', text)
    text = re.sub(r'\d+', '', text)
    return f"This column represents {text}"

# Embeddings
def encode_batch(texts):
    return model.encode(texts, batch_size=32)

# Structure Validation
def validate_structure(cols_old, cols_new):
    return {
        "same_count": len(cols_old) == len(cols_new),
        "same_order": cols_old == cols_new,
        "missing": list(set(cols_old) - set(cols_new)),
        "new": list(set(cols_new) - set(cols_old)),
        "reordered": set(cols_old) == set(cols_new) and cols_old != cols_new
    }

# String-based similarity
def token_overlap(a, b):
    a_set = set(a.split())
    b_set = set(b.split())
    return len(a_set & b_set) / max(len(a_set), 1)

# Column Matching Engine
def match_columns(old_cols, new_cols):
    if not old_cols or not new_cols:
        return []

    old_proc = [normalize(c) for c in old_cols]
    new_proc = [normalize(c) for c in new_cols]

    old_emb = encode_batch(old_proc)
    new_emb = encode_batch(new_proc)

    sim_matrix = util.cos_sim(old_emb, new_emb)

    matches = []

    for i, old_col in enumerate(old_cols):
        best_j = sim_matrix[i].argmax()
        cos_score = sim_matrix[i][best_j].item()

        lexical_score = token_overlap(old_proc[i], new_proc[best_j])

        final_score = 0.7 * cos_score + 0.3 * lexical_score

        if final_score > SIM_THRESHOLD_LOW:
            matches.append({
                "old": old_col,
                "new": new_cols[best_j],
                "score": round(final_score, 3),
                "confidence": (
                    "high" if final_score > SIM_THRESHOLD_HIGH else "medium"
                )
            })

    return matches

# Report generation
def generate_report(structure, matches):
    lines = []
    lines.append("=== SCHEMA VALIDATION REPORT ===\n")

    lines.append(f"Same column count: {structure['same_count']}")
    lines.append(f"Same order: {structure['same_order']}")
    lines.append(f"Reordered: {structure['reordered']}\n")

    lines.append(f"Missing columns: {structure['missing']}")
    lines.append(f"New columns: {structure['new']}\n")

    if matches:
        lines.append("Predicted column mappings:")
        for m in matches:
            lines.append(
                f"{m['old']} → {m['new']} "
                f"(score: {m['score']}, {m['confidence']})"
            )
    else:
        lines.append("No meaningful matches found.")

    return "\n".join(lines)

# Main Pipeline
def run_pipeline(file_old, file_new):
    cols_old = get_columns(file_old)
    cols_new = get_columns(file_new)

    structure = validate_structure(cols_old, cols_new)
    matches = match_columns(structure["missing"], structure["new"])

    return generate_report(structure, matches)

# UI
def select_old():
    path = filedialog.askopenfilename(title="Select Previous File")
    old_var.set(path)

def select_new():
    path = filedialog.askopenfilename(title="Select Current File")
    new_var.set(path)

def execute():
    old_file = old_var.get()
    new_file = new_var.get()

    if not old_file or not new_file:
        messagebox.showerror("Error", "Select both files")
        return

    try:
        result = run_pipeline(old_file, new_file)
        output.delete(1.0, tk.END)
        output.insert(tk.END, result)
    except Exception as e:
        messagebox.showerror("Error", str(e))

# Tkinter
root = tk.Tk()
root.title("Schema Drift Detection Tool")
root.geometry("800x600")

old_var = tk.StringVar()
new_var = tk.StringVar()

tk.Label(root, text="Previous File").pack()
tk.Entry(root, textvariable=old_var, width=90).pack()
tk.Button(root, text="Browse", command=select_old).pack()

tk.Label(root, text="Current File").pack()
tk.Entry(root, textvariable=new_var, width=90).pack()
tk.Button(root, text="Browse", command=select_new).pack()

tk.Button(root, text="Run Validation", command=execute, bg="green", fg="white").pack(pady=10)

output = tk.Text(root, wrap="word")
output.pack(expand=True, fill="both")

root.mainloop()
